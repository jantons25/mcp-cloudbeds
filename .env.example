# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a git ni compartas su contenido.

# API key de Cloudbeds (empieza por cbat_).
# Recomendado: déjala vacía y guárdala en el keyring con scripts/guardar_key.py
# (Administrador de credenciales de Windows / Llavero de macOS). El keyring tiene prioridad.
CLOUDBEDS_API_KEY=

# Usar el keyring del sistema para la API key: true / false
CLOUDBEDS_USE_KEYRING=true

# ID de la propiedad. Si lo dejas vacío, la prueba de humo de F1 lo mostrará.
CLOUDBEDS_PROPERTY_ID=

# Mostrar datos personales de huéspedes (email, teléfono, documento): true / false
CLOUDBEDS_SHOW_PII=false

# Zona horaria para calcular "hoy", "mañana", etc.
CLOUDBEDS_TZ=America/Lima

# Tope de resultados en consultas paginadas (1 a 5000)
CLOUDBEDS_MAX_RESULTS=500
