# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a git ni compartas su contenido.
#
# VARIOS HOTELES (recomendado): la lista de hoteles va en hoteles.json y la key de cada
# uno en el keyring. Ambos se crean con: python scripts/agregar_hotel.py --alias <alias>
# En ese caso deja vacíos CLOUDBEDS_API_KEY y CLOUDBEDS_PROPERTY_ID: cada hotel tiene los suyos.
# Las opciones de abajo (PII, zona horaria por defecto y tope de resultados) valen para todos.

# --- Solo para la instalación de UN hotel (sin hoteles.json) ---
# API key de Cloudbeds (empieza por cbat_).
# Recomendado: déjala vacía y guárdala en el keyring con scripts/guardar_key.py
# (Administrador de credenciales de Windows / Llavero de macOS). El keyring tiene prioridad.
CLOUDBEDS_API_KEY=

# ID de la propiedad. Si lo dejas vacío, la prueba de humo lo mostrará.
# Con hoteles.json, la key de arriba solo se usa para el hotel con este property_id.
CLOUDBEDS_PROPERTY_ID=

# --- Para todos los hoteles ---
# Usar el keyring del sistema para las API keys: true / false
CLOUDBEDS_USE_KEYRING=true

# Mostrar datos personales de huéspedes (email, teléfono, documento): true / false
CLOUDBEDS_SHOW_PII=false

# Zona horaria para calcular "hoy", "mañana", etc. si el hotel no tiene "tz" en hoteles.json
CLOUDBEDS_TZ=America/Lima

# Tope de resultados en consultas paginadas (1 a 5000)
CLOUDBEDS_MAX_RESULTS=500
